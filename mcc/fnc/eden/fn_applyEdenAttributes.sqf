/*
	MCC_fnc_applyEdenAttributes  (postInit, server)
	Copies MCC scenario attributes set in Eden (the Eden top menu MCC 5 > MCC 5 Mission Settings) over the matching CBA settings.
	Every attribute has a "Use addon setting" state (Combo -1 / -99999 / "" or an empty Edit box) that keeps the CBA value.

	Two maps:
	- MCC_edenAttributeMap: the hand-written attributes in config.cpp (class MCC_Attributes).
	- MCC_edenSettingsMap: generated by tools/gen_eden_settings.py (mcc\fnc\eden\edenSettingsMap.sqf), one attribute
	  (property MCC5S_<variable>) per MCC CBA setting, shown in mcc\cfg\eden\settingsAttributes.hpp.

	Values are applied through CBA so the setting's own script runs on every machine (also JIP):
		[_setting, _value, 1, "server"] call CBA_settings_fnc_set
	(CBA_A3 addons/settings/fnc_set.sqf: [_setting, _value, _priority, _source, _store]). Source "server" with priority 1
	overrides client values; a setting forced by the mission's cba_settings.sqf or forced by the server admin with
	"overwrite mission" priority still wins and is logged.
	Variables that are not CBA settings (or CBA missing) fall back to missionNamespace setVariable (public).

	MCC registers its CBA settings in PostInit, so this waits until the mission is running and the settings exist,
	otherwise the CBA registration would overwrite the Eden value.
	Missions without Eden attributes can set the same names in description.ext (e.g. MCC_logisticsMode = 2;).

	Params: none. Returns: nothing.
*/
if (!isServer) exitWith {};

// [scenario attribute (property), missionNamespace variable, (optional) BOOL setting: 0 = off, 1 = on]
MCC_edenAttributeMap = [
	["MCC_logisticsMode", "MCC_logisticsMode"],
	["MCC_MWmaxObjectives", "MCC_MWmaxObjectives"],
	["MCC_MWmissionSize", "MCC_MWmissionSize"],
	["MCC_MWmaxSpawnedUnits", "MCC_MWmaxSpawnedUnits"],
	["MCC_campaignMaxAOs", "MCC_campaignMaxAOs"],
	["MCC_campaignAOSize", "MCC_campaignAOSize"],
	["MCC_campaignAmbientCap", "MCC_campaignAmbientCap"],
	["MCC_GAIA_SUPPORT_ENABLED", "MCC_GAIA_SUPPORT_ENABLED", true],
	["MCC_GAIA_SUPPORT_ARTY", "MCC_GAIA_SUPPORT_ARTY", true],
	["MCC_GAIA_SUPPORT_CAS", "MCC_GAIA_SUPPORT_CAS", true],
	["MCC_GAIA_SUPPORT_REINF", "MCC_GAIA_SUPPORT_REINF", true],
	["MCC_GAIA_COORDINATION", "MCC_GAIA_COORDINATION", true],
	["MCC_GAIA_HC_BALANCE", "MCC_GAIA_HC_BALANCE", true],
	["MCC_zeusForMCCUsers", "MCC_zeusForMCCUsers", true]
];

// [property, CBA setting variable, kind (, kind args)] - generated, do not edit here
MCC_edenSettingsMap =
#include "edenSettingsMap.sqf"
;

[] spawn {
	// wait for the mission to run and for MCC's PostInit CBA settings to be registered (logistics is included last)
	waitUntil {time > 1};
	waitUntil {
		time > 30 || {isNil "CBA_settings_fnc_get"} || {!isNil {["MCC_logisticsMode", "default"] call CBA_settings_fnc_get}}
	};

	// [_var, _value, _attr, _isCBAOnly] - returns nothing
	private _fnc_apply = {
		params ["_var", "_value", "_attr", ["_cbaOnly", false]];
		private _hasCBA = !isNil "CBA_settings_fnc_set" && {!isNil "CBA_settings_fnc_get"};
		if (_hasCBA && {!isNil {[_var, "default"] call CBA_settings_fnc_get}}) then {
			[_var, _value, 1, "server"] call CBA_settings_fnc_set;
			private _now = [_var] call CBA_settings_fnc_get;
			if (_now isEqualTo _value) then {
				diag_log format ["MCC: Eden attribute %1 -> CBA setting %2 = %3", _attr, _var, _value];
			} else {
				diag_log format ["MCC: Eden attribute %1 = %2 not applied to CBA setting %3 (invalid value or a forced mission/server setting wins, current %4)", _attr, _value, _var, _now];
			};
		} else {
			if (_cbaOnly && _hasCBA) exitWith {
				diag_log format ["MCC: Eden attribute %1 ignored, CBA setting %2 is not registered in this mission", _attr, _var];
			};
			missionNamespace setVariable [_var, _value, true];
			diag_log format ["MCC: Eden attribute %1 = %2 (missionNamespace)", _attr, _value];
		};
	};

	// hand-written attributes: number, -1 = use addon setting
	{
		_x params ["_attr", "_var", ["_isBool", false]];
		private _value = getMissionConfigValue [_attr, -1];
		if (_value isEqualType "") then {_value = if (_value isEqualTo "") then {-1} else {parseNumber _value}};
		if (_value isEqualType 0 && {_value >= 0}) then {
			if (_isBool) then {_value = _value > 0};
			[_var, _value, _attr] call _fnc_apply;
		};
	} forEach MCC_edenAttributeMap;

	// generated attributes (one per CBA setting)
	{
		_x params ["_attr", "_var", "_kind", ["_arg1", -1], ["_arg2", 0]];
		private _raw = getMissionConfigValue _attr; // nil when the mission never saved this attribute
		private _value = nil;
		if (isNil "_raw") then {_raw = -1; _kind = ""};
		switch (_kind) do {
			case "bool": {
				if (_raw isEqualType "") then {_raw = if (_raw isEqualTo "") then {-1} else {parseNumber _raw}};
				if (_raw isEqualType 0 && {_raw >= 0}) then {_value = _raw > 0};
			};
			case "list_number": {
				// _arg1 = sentinel ("use addon setting")
				if (_raw isEqualType "") then {_raw = if (_raw isEqualTo "") then {_arg1} else {parseNumber _raw}};
				if (_raw isEqualType 0 && {_raw != _arg1}) then {_value = _raw};
			};
			case "list_string": {
				if (_raw isEqualType "" && {_raw != ""}) then {_value = _raw};
			};
			case "slider": {
				// _arg1 = min, _arg2 = max; empty text = use addon setting
				if (_raw isEqualType 0) then {_raw = str _raw};
				if (_raw isEqualType "") then {
					private _text = trim _raw;
					if (_text isEqualTo "") exitWith {};
					if !(_text regexMatch "^-?[0-9]*\.?[0-9]+$") exitWith {
						diag_log format ["MCC: Eden attribute %1 = '%2' is not a number, ignored", _attr, _text];
					};
					_value = (parseNumber _text) max _arg1 min _arg2;
				};
			};
			case "editbox": {
				if (_raw isEqualType 0) then {_raw = str _raw};
				if (_raw isEqualType "" && {(trim _raw) != ""}) then {_value = _raw};
			};
		};
		if (!isNil "_value") then {
			[_var, _value, _attr, true] call _fnc_apply;
		};
	} forEach MCC_edenSettingsMap;
};
